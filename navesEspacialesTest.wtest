import naves.*

describe "Propulsión" {

		const naveDeCarga = new NaveDeCarga()
		const naveDePasajeros = new NaveDePasajeros(velocidad = 290000)

		test "una nave de carga aumenta su velocidad al propulsarse" {
			naveDeCarga.propulsarse()
			assert.equals(20000, naveDeCarga.velocidad())
		}

		test "una nave de pasajeros no supera la velocidad máxima al propulsarse" {
			naveDePasajeros.propulsarse()
			assert.equals(300000, naveDePasajeros.velocidad())
		}
}

describe "Nave de carga" {

		const naveEnFalta = new NaveDeCarga(carga = 120000, velocidad = 110000)
		const naveParaAmenaza = new NaveDeCarga(carga = 120000, velocidad = 110000)
		const naveEnRegla = new NaveDeCarga(carga = 100000, velocidad = 110000)

		test "detecta sobrecarga y exceso de velocidad" {
			assert.that(naveEnFalta.estaSobrecargada())
			assert.that(naveEnFalta.estaExcedidaDeVelocidad())
			assert.that(naveEnFalta.estaEnFalta())
		}

		test "amenaza vacia la carga" {
			naveParaAmenaza.recibirAmenaza()
			assert.equals(0, naveParaAmenaza.carga())
			assert.notThat(naveParaAmenaza.estaSobrecargada())
		}

		test "el control solo amenaza a una nave en falta" {
			naveEnFalta.recibirControl()
			naveEnRegla.recibirControl()
			assert.equals(0, naveEnFalta.carga())
			assert.equals(100000, naveEnRegla.carga())
		}
}

describe "Nave de carga radioactiva" {

		const naveRadioactiva = new NaveDeCargaRadioactiva(carga = 5000, velocidad = 10000)

		test "al recibir una amenaza frena sin liberar la carga y puede sellarse al vacio" {
			naveRadioactiva.sellarAlVacio()
			naveRadioactiva.recibirAmenaza()
			assert.equals(0, naveRadioactiva.velocidad())
			assert.equals(5000, naveRadioactiva.carga())
			assert.that(naveRadioactiva.selladaAlVacio())
		}
}

describe "Nave de pasajeros" {

		const naveConPasajeros = new NaveDePasajeros(pasajeros = 50, velocidad = 10000)
		const naveParaAmenaza = new NaveDePasajeros(pasajeros = 50, velocidad = 5000)
		const naveConMuchosPasajeros = new NaveDePasajeros(pasajeros = 101)

		test "calcula la velocidad maxima legal" {
			assert.equals(300000 / 54, naveConPasajeros.velocidadMaximaLegal())
		}

		test "a diez mil kms por segundo esta en peligro" {
			assert.that(naveConPasajeros.estaEnPeligro())
		}

		test "descuenta velocidad por seguridad cuando supera cien pasajeros" {
			assert.equals(300000 / 105 - 200, naveConMuchosPasajeros.velocidadMaximaLegal())
		}

		test "la amenaza activa la alarma y pone a la nave en peligro" {
			assert.notThat(naveParaAmenaza.estaEnPeligro())
			naveParaAmenaza.recibirAmenaza()
			assert.that(naveParaAmenaza.alarmaDeEmergencia())
			assert.that(naveParaAmenaza.estaEnPeligro())
		}
}

describe "Nave de combate" {

		const naveEnAtaque = new NaveDeCombate(estaEnModoAtaque = true, velocidad = 8000)
		const naveEnReposo = new NaveDeCombate(estaEnModoAtaque = false, velocidad = 8000)

		test "es invisible en modo ataque por debajo de diez mil kms por segundo" {
			assert.that(naveEnAtaque.estaInvisible())
		}

		test "amenaza en modo ataque emite el mensaje correspondiente" {
			naveEnAtaque.recibirAmenaza()
			assert.equals("Enemigo encontrado", naveEnAtaque.ultimoMensaje())
		}

		test "amenaza en reposo emite retirada" {
			naveEnReposo.recibirAmenaza()
			assert.equals("¡RETIRADA!", naveEnReposo.ultimoMensaje())
	}
}
